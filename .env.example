# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit API keys.

# --- AI provider (choose one) -------------------------------------------

# Option A: Anthropic API (default)
# Get your key at https://console.anthropic.com/
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option B: AWS Bedrock
# Requires AWS credentials: a Bedrock API key (recommended, see the AWS
# credentials section below), or access keys / AWS_PROFILE / an IAM role with
# bedrock:InvokeModel permission on the model below.
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5   # default: "anthropic." + CLAUDE_MODEL

# Claude model for EDL generation (applies to both providers)
# CLAUDE_MODEL=claude-opus-5-5

# --- Transcription provider (choose one) ----------------------------------

# Option A: Local faster-whisper (default) — no AWS needed.
TRANSCRIBE_PROVIDER=local

# Option B: Amazon Transcribe — requires AWS credentials (same as Bedrock
# above) with transcribe:StartTranscriptionJob / GetTranscriptionJob and
# s3:PutObject/GetObject/DeleteObject on the bucket below.
# Deploy infra/ (cdk deploy) to create this bucket, or point at your own.
# TRANSCRIBE_PROVIDER=aws
# TRANSCRIBE_S3_BUCKET=darkroom-transcribe-xxxxxxxx
# AWS_REGION=us-east-1

# --- AWS credentials (only for Bedrock / Amazon Transcribe) ----------------
# Recommended over `aws sso login`, whose sessions expire mid-job. See
# "6 — AWS credentials" in the README for the IAM policy and setup.

# Bedrock API key — used instead of your AWS login for Bedrock calls.
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key

# Access keys for a dedicated, narrowly-scoped IAM user (Amazon Transcribe).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Local Whisper performance tuning (optional) --------------------------
# Machine-level hardware settings for the local faster-whisper path — see
# "Tuning local performance" in the README before changing these. Defaults
# below match faster-whisper's own defaults, so leaving this section
# commented out is identical to today's behavior.

# device: "auto" | "cpu" | "cuda"  — GPU acceleration is NVIDIA-only (CUDA).
# AMD/Intel GPUs are not supported by faster-whisper's backend; "auto" will
# silently fall back to CPU on those systems, which is already the default.
# WHISPER_DEVICE=auto

# compute_type: "default" | "int8" | "int8_float32" | "float32" | "float16" (GPU only) | ...
# int8 is the fastest CPU option, usually with negligible accuracy loss.
# WHISPER_COMPUTE_TYPE=int8

# cpu_threads: 0 = autodetect. Set to your physical core count (not thread
# count) as a starting point if autodetect isn't using your CPU well.
# WHISPER_CPU_THREADS=0

# --- Storage -------------------------------------------------------------

# Optional: override where projects are stored (default: ./projects)
# DARKROOM_PROJECTS_DIR=/path/to/your/projects
