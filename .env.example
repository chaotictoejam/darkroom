# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit API keys.

# --- AI provider (choose one) -------------------------------------------

# Option A: Anthropic API (default)
# WARNING: transcripts are sent to Anthropic, a third party, outside your
# machine and your cloud account. See "What leaves your machine" in README.md.
# For confidential recordings use Option B (Bedrock in your own AWS account).
# Get your key at https://console.anthropic.com/
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option B: AWS Bedrock (recommended for privacy; stays in your AWS account)
# No API key: uses your AWS credentials (`aws login`, AWS_PROFILE,
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an IAM role) with
# bedrock:InvokeModelWithResponseStream on the model, plus bedrock:GetAccountDataRetention
# and bedrock:ListInferenceProfiles (see docs/bedrock-iam.md for a policy).
# Install: pip install -e "backend/[bedrock]"
# Set your account's data retention mode to none: see "What leaves your machine" in README.md.
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
#
# Default model: Claude Sonnet 4.5 through the inference profile for AWS_REGION's own
# geography (us., eu., jp., au., ...), looked up in AWS. Regions with no such profile
# (e.g. ca-central-1, ap-south-1) are refused rather than routed elsewhere: set
# BEDROCK_MODEL_ID to accept another geography.
# BEDROCK_IN_REGION=1 processes in AWS_REGION only, for models that support it
# (current Claude models don't; Darkroom checks and refuses).
# BEDROCK_IN_REGION=1
# Or pick a model yourself. global. model IDs are refused.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Claude Fable 5 / 5.1 require retention mode aws_review (AWS keeps requests up to
# 30 days and may review flagged ones). Refused unless you set:
# BEDROCK_ALLOW_RETENTION_MODELS=1

# --- Storage -------------------------------------------------------------

# Optional: override where projects are stored (default: ./projects)
# DARKROOM_PROJECTS_DIR=/path/to/your/projects
